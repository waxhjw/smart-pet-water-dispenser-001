{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PY32F002B: DAPLink 调试",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "pyocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/target/py32f002b/build/sp01_py32f002b.elf",
      "gdbPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin/arm-none-eabi-gdb.exe",
      "armToolchainPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin",
      "toolchainPrefix": "arm-none-eabi",
      "serverpath": "${workspaceFolder}/.pyocd-venv/Scripts/pyocd.exe",
      "cmsisPack": "${workspaceFolder}/.tools/pyocd-packs/Puya.PY32F0xx_DFP.1.2.8.pack",
      "targetId": "py32f002bx5",
      "overrideGDBServerStartedRegex": "GDB server listening on port",
      "serverArgs": [
        "--frequency",
        "100000"
      ],
      "objdumpPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin/arm-none-eabi-objdump.exe",
      "preLaunchTask": "SP01: debug preflight",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "both",
      "showDevDebugTimestamps": true
    },
    {
      "name": "PY32F002B: Type-C 台架（强制关泵）",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "pyocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/target/py32f002b/build-bench-no-pump/sp01_py32f002b.elf",
      "gdbPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin/arm-none-eabi-gdb.exe",
      "armToolchainPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin",
      "toolchainPrefix": "arm-none-eabi",
      "serverpath": "${workspaceFolder}/.pyocd-venv/Scripts/pyocd.exe",
      "cmsisPack": "${workspaceFolder}/.tools/pyocd-packs/Puya.PY32F0xx_DFP.1.2.8.pack",
      "targetId": "py32f002bx5",
      "overrideGDBServerStartedRegex": "GDB server listening on port",
      "serverArgs": [
        "--frequency",
        "100000"
      ],
      "objdumpPath": "${workspaceFolder}/tools/toolchains/arm-gnu-toolchain-15.2.rel1/bin/arm-none-eabi-objdump.exe",
      "preLaunchTask": "SP01: bench no-pump debug preflight",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "both",
      "showDevDebugTimestamps": true
    }
  ]
}
